{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "types": ["@modern-js/app-tools/types"],
    "declaration": false,
    "jsx": "preserve",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./api/lambda/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "src",
    "api",
    "server",
    "shared",
    "scripts",
    "modern.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "e2e",
    "tests",
    "playwright.config.ts",
    "otel.ts"
  ],
  "exclude": ["**/node_modules"]
}
