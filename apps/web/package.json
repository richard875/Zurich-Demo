{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "modern dev",
    "build": "MODERNJS_DEPLOY=node modern deploy && pnpm build:otel",
    "typecheck": "tsc --noEmit",
    "db:init": "node scripts/db-init.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "start": "node --import ./.output/otel.mjs .output/index",
    "build:otel": "esbuild otel.ts --bundle --platform=node --target=node22 --format=esm --outfile=.output/otel.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "engines": {
    "node": "^22.18.0 || >=24.3.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1153.0",
    "@aws-sdk/client-sns": "3.1153.0",
    "@aws-sdk/lib-dynamodb": "3.1153.0",
    "@fingerprintjs/fingerprintjs": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@modern-js/plugin-bff": "3.10.1",
    "@modern-js/runtime": "3.10.1",
    "@modern-js/server-runtime": "3.10.1",
    "@tanstack/react-query": "^5.104.5",
    "@zurich/css-components": "0.8.1",
    "@zurich/design-tokens": "0.8.1",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.0",
    "hono": "4.13.13",
    "pino": "^10.4.0",
    "policy-issuer": "workspace:*",
    "radix-ui": "^1.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modern-js/app-tools": "3.10.1",
    "@modern-js/tsconfig": "3.10.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/id-generator-aws-xray": "^2.1.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.78.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/propagator-aws-xray": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
